# Application
APP_NAME=AI Orchestrator
APP_ENV=development
APP_DEBUG=false
APP_HOST=0.0.0.0
APP_PORT=8000
APP_VERSION=0.1.0
LOG_LEVEL=INFO
LOG_JSON=false

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://localhost:5173

# LLM Provider: ollama | openai
LLM_PROVIDER=ollama

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TEMPERATURE=0.1
OLLAMA_TIMEOUT_SECONDS=120

# OpenAI (future — set LLM_PROVIDER=openai to enable)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_TEMPERATURE=0.1

# IAM Service
IAM_SERVICE_URL=http://localhost:3001
IAM_PERMISSIONS_PATH=/api/v1/auth/permissions
IAM_VALIDATE_TOKEN_PATH=/api/v1/auth/validate
IAM_TIMEOUT_SECONDS=10

# Downstream microservices (base URLs)
USER_SERVICE_URL=http://localhost:8001
MODULE_SERVICE_URL=http://localhost:8002

# Agent
AGENT_MAX_ITERATIONS=10
DEFAULT_AGENT_ID=orchestrator

# Audit & observability
AUDIT_ENABLED=true
OTEL_ENABLED=false
OTEL_SERVICE_NAME=ai-orchestrator

# Vector store (future RAG): none | qdrant | pgvector
VECTOR_STORE_PROVIDER=none
QDRANT_URL=http://localhost:6333

# Channels
WEBSOCKET_ENABLED=false
